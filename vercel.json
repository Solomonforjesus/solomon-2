{
  "rewrites": [
    { "source": "/stickers/solomon-stickers.zip", "destination": "/api/sticker-download" }
  ],
  "headers": [
    {
      "source": "/stickers/files/solomon-stickers.zip",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Solomon-Stickers.zip\"" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
